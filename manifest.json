{
  "manifest_version": 3,
  "name": "Discord Web Auto Quest Extension",
  "version": "1.2.6",
  "description": "Automatically complete Discord quests in the browser without any manual work",
  "icons": {
    "16": "assets/Logo/logo16.png",
    "32": "assets/Logo/logo32.png",
    "48": "assets/Logo/logo48.png",
    "128": "assets/Logo/logo128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/Logo/logo16.png",
      "32": "assets/Logo/logo32.png",
      "48": "assets/Logo/logo48.png",
      "128": "assets/Logo/logo128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/Logo/*.png"],
      "matches": ["https://discord.com/*", "https://canary.discord.com/*"]
    }
  ],
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "activeTab"
  ],
  "host_permissions": ["https://*.discord.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*", "https://canary.discord.com/*"],
      "js": ["quest-home.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://discord.com/*", "https://canary.discord.com/*"],
      "js": ["user-agent-override.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
